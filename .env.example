# База данных — PostgreSQL на Neon (https://neon.tech)
# Получить: Neon Console → Project → Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Пароль для входа в /admin
# Выбрать надёжный пароль перед деплоем
ADMIN_PASSWORD="your-secure-password-here"

# Яндекс Метрика (опционально)
# Получить: metrika.yandex.ru → Счётчики → ID счётчика
NEXT_PUBLIC_YM_COUNTER=""
